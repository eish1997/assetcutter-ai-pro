{
  "name": "@assetcutter/companion-desktop",
  "private": true,
  "version": "0.2.1",
  "author": "AssetCutter Team",
  "description": "本地伴侣桌面壳：托盘、设置内配对、启动 local-companion",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "write-build-constants": "node ./scripts/write-build-constants.cjs",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-build-artifacts.ps1",
    "pack": "npm run write-build-constants && npm run bundle:local-companion && node ./scripts/electron-build-with-suffix.cjs dir",
    "copy:sam-local-bundled": "node ./scripts/copy-sam-local-for-desktop.cjs",
    "bundle:local-companion": "node ./scripts/copy-sam-local-for-desktop.cjs && node ./scripts/bundle-local-companion-runtime.cjs",
    "dist:win": "npm run write-build-constants && npm run bundle:local-companion && node ./scripts/electron-build-with-suffix.cjs nsis",
    "dist:portable": "npm run write-build-constants && npm run bundle:local-companion && node ./scripts/electron-build-with-suffix.cjs portable"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.27.7"
  },
  "build": {
    "appId": "com.assetcutter.companion",
    "productName": "AssetCutterCompanion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "companion-auto-update.cjs",
      "build-constants.json",
      "preload-shell.cjs",
      "preload-tool-window.cjs",
      "preload-workbench.cjs",
      "companion-sandbox-paths.cjs",
      "embedded-browser-manager.cjs",
      "agent-store.cjs",
      "agent-body-host.cjs",
      "agent-tool-schemas.cjs",
      "agent-policy.cjs",
      "agent-partition-fetch.cjs",
      "agent-workbench-client.cjs",
      "agent-script-hub-client.cjs",
      "agent-body-mcp.cjs",
      "hermes-official-host.cjs",
      "hermes-cli-resolve.cjs",
      "hermes-gateway-host.cjs",
      "companion-connect.cjs",
      "agent-skills.cjs",
      "agent-memory.cjs",
      "agent-types.d.ts",
      "agent-session/index.cjs",
      "brain-adapters/**/*",
      "shell/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "local-companion-bundle",
        "to": "local-companion-bundle",
        "filter": ["**/*"]
      },
      {
        "from": "sam-local-bundled",
        "to": "sam-local-bundled",
        "filter": ["**/*"]
      },
      {
        "from": "sam-local-bootstrap",
        "to": "sam-local-bootstrap",
        "filter": ["**/*"]
      },
      {
        "from": "rembg-bootstrap",
        "to": "rembg-bootstrap",
        "filter": ["**/*"]
      },
      {
        "from": "paddleocr-bootstrap",
        "to": "paddleocr-bootstrap",
        "filter": ["**/*"]
      },
      {
        "from": "../hermes-bootstrap",
        "to": "hermes-bootstrap",
        "filter": ["dev-gateway.mjs"]
      },
      {
        "from": "hermes-bootstrap",
        "to": "hermes-bootstrap",
        "filter": ["hermes-bootstrap.cjs"]
      },
      {
        "from": "../local-companion/paddleocr-service",
        "to": "paddleocr-service",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "AssetCutterCompanion-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": true,
      "differentialPackage": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
