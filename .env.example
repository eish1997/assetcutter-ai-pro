# 可选：入站密码。设置后进入网站需先输入密码（会话内有效，关掉标签页后需重新输入）
# 留空或不设置则不启用密码门控
VITE_SITE_PASSWORD=

# 可选：管理后台密码。设置后访问 /admin 需先输入此密码（会话内有效）
# 留空或不设置则 /admin 无需二次密码
VITE_ADMIN_PASSWORD=

# 用户系统（邮箱密码 + RBAC）
# Auth API 默认监听 127.0.0.1:9100，前端开发环境通过 Vite 代理访问 /api/auth/* 与 /api/admin/*
AUTH_PORT=9100
AUTH_BIND_HOST=127.0.0.1
# 生产建议：显式限制允许的前端域名（逗号分隔），用于 CORS + 写接口 Origin 校验
# AUTH_ALLOWED_ORIGINS=https://assetcutter-web.onrender.com,https://assetcutter-ai-pro.vercel.app
# 可选：前端直连认证 API 根地址（用于前后端分域部署，如 Render 静态站 + Render Web Service）
# VITE_AUTH_API_BASE_URL=https://your-auth-service.onrender.com
# 可选：R2 中间层根地址。未设时与 VITE_AUTH_API_BASE_URL 相同（推荐：R2 挂在 auth 同源 /api/r2，生产只配 VITE_AUTH_API_BASE_URL 即可）
# VITE_R2_API_BASE_URL=https://your-auth-service.onrender.com
# 生产推荐：认证数据改走 Postgres（设置后 auth-api 自动用数据库存储用户与会话）
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# 本地 Script Hub 联调（Docker Postgres，端口 55432）：仓库根 `npm run pg:dev:script-hub`，见 docker-compose.script-hub-dev.yml
# DATABASE_URL=postgres://assetcutter:assetcutter_dev@127.0.0.1:55432/assetcutter
# 可选：登录/注册限流参数
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_REGISTER_RATE_LIMIT_MAX=20
# 注册模式：open（开放注册）| invite_only（默认，须一次性邀请码 AC-XXXX-XXXX 或 ?invite=）
# 本地开放注册测试：在 .env.local 设 REGISTRATION_MODE=open 并重启 auth-api
# REGISTRATION_MODE=open
# 生产双子域共享登录：会话 Cookie 的 Domain（须以点开头，如 .adrazzo.com）。不设则仅当前 Host 有效（本地开发一般不设）。
# AUTH_COOKIE_DOMAIN=.adrazzo.com
# Script Hub 业务 API（独立进程，默认 9101）；CORS 白名单（逗号分隔），生产必填
# SCRIPT_HUB_API_PORT=9101
# SCRIPT_HUB_BIND_HOST=127.0.0.1
# SCRIPT_HUB_ALLOWED_ORIGINS=https://scripts.adrazzo.com,https://app.adrazzo.com
# 伴侣无 Cookie 拉 revision 正文：HS256 短期 JWT（至少 16 字符）；可选 TTL 秒（默认 300，最大 3600）
# SCRIPT_HUB_CONTENT_JWT_SECRET=your-long-random-secret-here
# SCRIPT_HUB_CONTENT_JWT_TTL_SEC=300
# 本机伴侣执行 Maya「cloud」脚本时拉正文：指向 script-hub-api 根（默认 http://127.0.0.1:9101）
# SCRIPT_HUB_API_BASE_URL=http://127.0.0.1:9101
# 可选：revision 正文存 R2（需已配置 R2_ACCOUNT_ID、R2_ACCESS_KEY_ID、R2_SECRET_ACCESS_KEY、R2_BUCKET）。设为 false 则强制仅用 Postgres content_body
# SCRIPT_HUB_USE_R2=true
# 可选：单 revision 正文最大字节（默认 524288）
# SCRIPT_HUB_MAX_REVISION_BYTES=524288
# 会话时长（毫秒），默认 7 天
AUTH_SESSION_TTL_MS=604800000
# 供应商选「试用」时：Gemini 代理异步任务每日配额（登录按账号，UTC 日；未登录为设备 localStorage）
TRIAL_GEMINI_DAILY_LIMIT=60
# 可选：与 TRIAL_GEMINI_DAILY_LIMIT 一致，用于前端访客提示与本地计数上限（不设则默认 60）
# VITE_TRIAL_GEMINI_DAILY_LIMIT=60
# 初始化管理员（执行 npm run seed:admin 前设置）
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=

# 促销积分 lot（限时发放，到期自动回收；需 CREDITS_BILLING 开启）
# CREDITS_PROMO_LOTS_ENABLED=false
# 到期 sweep 间隔（毫秒），默认 900000（15 分钟）
# CREDITS_PROMO_SWEEP_MS=900000
# 连续 sweep 失败 N 次后打 ALERT 日志并尝试 Webhook（默认 3）
# CREDITS_PROMO_SWEEP_ALERT_FAILS=3

# Gemini：不再从构建环境注入。请在网站设置页填写，仅保存在当前浏览器本机。
# 可选：工作流「切割图片」区域识别单次超时（毫秒），默认 90000；仍超时则会整图裁一块
# VITE_WORKFLOW_CUT_DETECT_TIMEOUT_MS=120000
# 工作流批处理本地并发（每 tab，1～8；20 人共享账号建议 1～2）
# VITE_WORKFLOW_MAX_CONCURRENCY=2
# 可选：工作区本地拖入 3D 模型（blob 预览）单文件大小上限，单位 MB，默认 80；超过则拒绝加入画布并在日志中提示
# VITE_WORKFLOW_LOCAL_MODEL_PREVIEW_MAX_MB=80

# 可选：生图档位运营策略 JSON（需可 CORS GET）；不设则仅使用内置默认（全部档位可用）。见 public/model-ops.example.json
# VITE_MODEL_OPS_CONFIG_URL=

# 可选：unifiedAiGateway 对 workflow* 委托输出 [unified-ai] 行 + { provider, registryId, errorHint? }（控制台），设为 1 开启，默认关闭
# VITE_DEBUG_UNIFIED_AI=1

# 可选：工作流「生视频」HTTP 桥 — POST JSON { prompt, referenceImages? } 到该 URL；响应 JSON 需含 videoUrl / url / videoDataUrl / videoBase64 等（见 services/workflowVideoBridge.ts）。请指向已鉴权的同源或可信代理，勿把供应商密钥写进 Vite 暴露变量。
# VITE_WORKFLOW_VIDEO_API_URL=/api/workflow-video

# VectorEngine：浏览器直连 https://api.vectorengine.ai 常因 CORS 出现 Failed to fetch。
# 本地 npm run dev 时默认已通过 Vite 走同源 /__vectorengine 代理，一般无需配置。
# 生产静态站需自行做同源反代，再把此处设为代理根地址，例如：https://你的域名/api/vectorengine
# VITE_VECTOR_ENGINE_PROXY=
# 仅本地调试：强制直连设置页中的地址（不走 /__vectorengine），用于验证代理商是否已支持浏览器跨域
# VITE_VECTOR_ENGINE_DIRECT=true

# OpenAI 官方（GPT Image / Chat）：浏览器直连 https://api.openai.com 常因 CORS 出现 Failed to fetch。
# 本地 npm run dev 时默认已通过 Vite 走同源 /__openai/v1 代理，一般无需配置。
# 本机访问 OpenAI 需翻墙时：Vite 反代出站不会自动用 git 代理；可复用已有 TRIPO_PROXY，或显式配置：
# OPENAI_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# 生产静态站需自行做同源反代，例如：https://你的域名/api/openai/v1
# VITE_OPENAI_PROXY=/api/openai/v1
# 仅本地调试：强制直连设置页中的 OpenAI Base URL（不走 /__openai）
# VITE_OPENAI_DIRECT=true

# 腾讯混元 3D：前端只暴露代理地址；真正的 SecretId / SecretKey 仅供 `npm run proxy` 使用
VITE_TENCENT_PROXY=http://127.0.0.1:9001
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 代理默认只绑定本机；仅在确有需要时显式改成 0.0.0.0，并务必同时设置 PROXY_AUTH_TOKEN
PROXY_BIND_HOST=127.0.0.1
# 非本机访问 ai3d-proxy 时必须携带的请求头：X-Proxy-Token
PROXY_AUTH_TOKEN=

# 仅限本地临时排障：允许浏览器直接持有腾讯云密钥。生产环境务必保持 false。
VITE_ALLOW_UNSAFE_TENCENT_BROWSER_CREDS=false

# 火山引擎 · 即梦 AI（W0 站点 AK，仅 auth-api 进程；默认关闭）
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
JIMENG_API_ENABLED=false
JIMENG_VISUAL_HOST=visual.volcengineapi.com
JIMENG_VISUAL_REGION=cn-north-1
JIMENG_VISUAL_SERVICE=cv
JIMENG_VISUAL_VERSION=2022-08-31
# JIMENG_UPSTREAM_TIMEOUT_MS=60000
# JIMENG_MAX_CONCURRENT_POLLS_PER_USER=3
# 浏览器可选；优先以 GET /api/jimeng/status 为准
# VITE_JIMENG_API_ENABLED=false

# Gemini 代理后端（试用/Vertex 必填）：与线上一致，见 .env.development / .env.production（默认 Render gemini-proxy）
# 本地与线上同路径联调：不设 VITE_BULK_*（继承 development）+ 本机 auth-api 开启中继：
#   GEMINI_PROXY_UPSTREAM_URL=https://assetcutter-gemini-proxy.onrender.com
# 浏览器请求 /api/gemini-proxy/* → auth-api → Render gemini-proxy（与 app.adrazzo.com 一致，非 __ac-bulk-forward）
# VITE_BULK_IMAGE_API=https://assetcutter-gemini-proxy.onrender.com
# VITE_BULK_IMAGE_API_VERTEX=https://assetcutter-gemini-proxy.onrender.com
# 仅调试本机 gemini-proxy 进程时在 .env.local 覆盖（勿用于 Vercel/生产构建，否则会 405）：
# VITE_BULK_IMAGE_API=same-origin
# 走 Vertex：在站点设置里选择「Vertex AI」供应商即可让请求体带 aiBackend:vertex（无需再设单独构建开关）。
# 旧版：独立 Vertex 供应商已并入「试用」；以下变量仅历史构建兼容，新配置可忽略
# VITE_BULK_IMAGE_API_VERTEX=
# VITE_VERTEX_FALLBACK_BULK_API=
# VITE_DISABLE_VERTEX_BULK_FALLBACK=
# GEMINI_API_KEY=xxx
# Vertex（可选，与 GEMINI_API_KEY 可并存；仅当请求 body 含 aiBackend:vertex 时使用）
# VERTEX_PROJECT_ID=your-gcp-project
# 或 GOOGLE_CLOUD_PROJECT=your-gcp-project
# VERTEX_LOCATION=global
# 或 GOOGLE_CLOUD_LOCATION=global
# 慎用于本机：若 gemini-proxy 走 GEMINI_API_KEY（async 未带 aiBackend:vertex），勿在同一 .env.local 打开此项，
# 否则 @google/genai 会从环境进入 Vertex 模式并报「API keys are not supported… OAuth2」。代理进程内已对 Key 路径强制 vertexai:false。
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 或整段 JSON（无文件路径时，代理会写临时文件供 ADC 使用；Render Dashboard 常用）
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
# BULK_IMAGE_PORT=9002
# 若同时配置了 VITE_BULK_IMAGE_API 与浏览器内 Gemini Key：默认优先使用后端代理（与线上一致）。
# 若需强制「本机 Key 直连 Google」：VITE_USE_BROWSER_GEMINI_KEY_FIRST=true
# VITE_USE_BROWSER_GEMINI_KEY_FIRST=
# 单次 POST JSON 最大体积（字节），默认约 25MB；大图 base64 可调大
# GEMINI_PROXY_MAX_BODY_BYTES=
# ---- Gemini 代理公平排队（可选，均在 gemini-proxy / auth-api 进程环境，非 Vite）----
# 20 人共享单账号建议开启并按 /admin/gemini-fairness 调参（见 docs/Gemini代理-公平排队与每用户限流.md §14）
GEMINI_FAIRNESS_ENABLED=true
# GEMINI_FAIRNESS_CONFIG_SOURCE=db   # db（有 DATABASE_URL 时默认）| disk | env_only（紧急回滚，忽略 UI 持久化）
# GEMINI_FAIRNESS_CONFIG_PATH=   # source=disk 时路径；默认 server/data/gemini-fairness-config.json
# 20 人起步（也可在管理页持久化，约 3s 热加载）：
# GEMINI_ASYNC_PROXY_MAX_CONCURRENT=4
# GEMINI_FAIRNESS_USER_MAX_IN_FLIGHT=1
# GEMINI_FAIRNESS_USER_MAX_QUEUED=3
# GEMINI_FAIRNESS_USER_SUBMIT_RPM=15
# GEMINI_FAIRNESS_GLOBAL_QUEUE_MAX=200
# gemini-proxy 与 auth-api 共享 DATABASE_URL 时，管理页写入 Postgres，proxy 约 3s 热加载
# GEMINI_PROXY_FAIRNESS_HMAC_SECRET=
# GEMINI_FAIRNESS_TRUST_CLIENT_KEY_HEADER=false   # 公网慎用：无 HMAC 时是否信任浏览器自带的 X-AC-Fairness-Key
# （其余每用户 RPM、排队深度等优先见磁盘 JSON 或 env；见 docs/Gemini代理-公平排队与每用户限流.md）
# Auth / R2 JSON API 请求体上限（字节），默认 4MB；上传文件仍走预签名 PUT
# API_JSON_BODY_MAX_BYTES=
# 能力商店预览图文件上限（字节），默认 8MB
# R2_CAPABILITY_PREVIEW_MAX_BYTES=
# 管理端发布能力包 POST 体上限（字节），默认 64MB
# CAPABILITY_PUBLISH_ADMIN_BODY_BYTES=

# Cloudflare R2 + 工作区云同步（可选）
# 启动：npm run dev:r2-api；开发时 Vite 已代理 /api/r2 → 9003
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# AUTH_ME_URL=http://127.0.0.1:9100/api/auth/me
# R2_ENFORCE_USER_SCOPE=true
# VITE_WORKSPACE_CLOUD 留空或 true 表示登录后同步工作区；设为 false 则仅用本地
# VITE_WORKSPACE_CLOUD=
# 关闭/切换项目时是否自动上传 projects-index.json 到 R2。默认 **关**（伴侣目录为公开项目真源，本地有什么读什么）。
# 设 VITE_WORKSPACE_CLOUD_INDEX_SYNC=1 可恢复「离开/切换时同步索引到云」。
# VITE_WORKSPACE_CLOUD_INDEX_SYNC=
# 打开工作区项目且已连接本地伴侣时：是否把 manifest 里「非 wf-orig / wf-res / wf-mdl」的遗留文件自动扫成多张新卡片。
# 默认关闭（不设或 false）：只按 wf-* 键合并到同一资产 UUID，避免画布与 JSON 里组/血缘被扫盘结果打乱。确需恢复旧目录散落文件时再设为 true。
# VITE_WORKSPACE_IMPORT_LEGACY_COMPANION_ORPHANS=false
# 自动同步间隔（毫秒，30000～3600000），默认 180000（3 分钟）；设大些更省后台上传、更流畅
# VITE_WORKSPACE_AUTO_SYNC_INTERVAL_MS=180000
#
# 打开已绑定项目时是否与 R2 上的 workflow.json 做「本地 ∪ 云端」合并（时间戳优先；pending 按 assetId+actionType 槽位）。
# 设为 0 / false / off 可关闭，避免每次打开项目请求云端。
# VITE_WORKSPACE_CLOUD_BUNDLE_MERGE=1
#
# 轻量结构同步：画布 assets/pending 变更后防抖 PUT 瘦身 workflow.json；无变更不 PUT；无编辑不挂防抖定时器。
# VITE_WORKSPACE_CLOUD_LITE_SYNC=1
# 防抖毫秒（5000～300000），默认 25000
# VITE_WORKSPACE_CLOUD_LITE_SYNC_MS=25000

# 本地伴侣（Node 进程环境变量，非 Vite 注入）：本机分割 SamLocal
# 默认 http://127.0.0.1:18081/v1/segment/predict ；启动：npm run dev:sam-local
# COMPANION_SAM_SEGMENT_URL=http://127.0.0.1:18081/v1/segment/predict
# COMPANION_SAM_SEGMENT_TIMEOUT_MS=120000
# runtime-status 内 Sam/rembg 探测短缓存（毫秒）：默认 8000；0 关闭；合法 500～120000
# COMPANION_RUNTIME_PROBE_CACHE_MS=8000
# GET /v1/script-connectors：仅缓存「Maya 探测成功」结果（毫秒）；默认 4000；0 关闭；合法 1～120000
# COMPANION_SCRIPT_CONNECTORS_CACHE_MS=4000
