# 可选：入站密码。设置后进入网站需先输入密码（会话内有效，关掉标签页后需重新输入）
# 留空或不设置则不启用密码门控
VITE_SITE_PASSWORD=

# 可选：管理后台密码。设置后访问 /admin 需先输入此密码（会话内有效）
# 留空或不设置则 /admin 无需二次密码
VITE_ADMIN_PASSWORD=

# 用户系统（邮箱密码 + RBAC）
# Auth API 默认监听 127.0.0.1:9100，前端开发环境通过 Vite 代理访问 /api/auth/* 与 /api/admin/*
AUTH_PORT=9100
AUTH_BIND_HOST=127.0.0.1
# 生产建议：显式限制允许的前端域名（逗号分隔），用于 CORS + 写接口 Origin 校验
# AUTH_ALLOWED_ORIGINS=https://assetcutter-web.onrender.com,https://assetcutter-ai-pro.vercel.app
# 可选：前端直连认证 API 根地址（用于前后端分域部署，如 Render 静态站 + Render Web Service）
# VITE_AUTH_API_BASE_URL=https://your-auth-service.onrender.com
# 生产推荐：认证数据改走 Postgres（设置后 auth-api 自动用数据库存储用户与会话）
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# 可选：登录/注册限流参数
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_LOGIN_RATE_LIMIT_MAX=10
# AUTH_REGISTER_RATE_LIMIT_MAX=20
# AUTH_RESET_RATE_LIMIT_MAX=8
# 可选：跨站 Cookie 策略（跨域前后端建议 none + true）
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_SECURE=true
# 可选：密码找回调试模式（true 时 forgot-password 返回 resetToken，生产建议 false）
# AUTH_PASSWORD_RESET_DEBUG=false
# 会话时长（毫秒），默认 7 天
AUTH_SESSION_TTL_MS=604800000
# 初始化管理员（执行 npm run seed:admin 前设置）
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=

# Gemini：不再从构建环境注入。请在网站设置页填写，仅保存在当前浏览器本机。

# VectorEngine：浏览器直连 https://api.vectorengine.ai 常因 CORS 出现 Failed to fetch。
# 本地 npm run dev 时默认已通过 Vite 走同源 /__vectorengine 代理，一般无需配置。
# 生产静态站需自行做同源反代，再把此处设为代理根地址，例如：https://你的域名/api/vectorengine
# VITE_VECTOR_ENGINE_PROXY=
# 仅本地调试：强制直连设置页中的地址（不走 /__vectorengine），用于验证代理商是否已支持浏览器跨域
# VITE_VECTOR_ENGINE_DIRECT=true

# 腾讯混元 3D：前端只暴露代理地址；真正的 SecretId / SecretKey 仅供 `npm run proxy` 使用
VITE_TENCENT_PROXY=http://127.0.0.1:9001
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 代理默认只绑定本机；仅在确有需要时显式改成 0.0.0.0，并务必同时设置 PROXY_AUTH_TOKEN
PROXY_BIND_HOST=127.0.0.1
# 非本机访问 ai3d-proxy 时必须携带的请求头：X-Proxy-Token
PROXY_AUTH_TOKEN=

# 仅限本地临时排障：允许浏览器直接持有腾讯云密钥。生产环境务必保持 false。
VITE_ALLOW_UNSAFE_TENCENT_BROWSER_CREDS=false

# Gemini 代理后端（可选）：未在浏览器配置官方 Key 时，可走 server/gemini-proxy-api.js 的 /proxy/gemini/async
# 启动：npm run dev:gemini-proxy
# VITE_BULK_IMAGE_API=http://localhost:9002
# GEMINI_API_KEY=xxx
# BULK_IMAGE_PORT=9002
