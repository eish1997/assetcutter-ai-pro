# 可选：入站密码。设置后进入网站需先输入密码（会话内有效，关掉标签页后需重新输入）
# 留空或不设置则不启用密码门控
VITE_SITE_PASSWORD=

# Gemini：不再从构建环境注入。请在网站设置页填写，仅保存在当前浏览器本机。

# 腾讯混元 3D：前端只暴露代理地址；真正的 SecretId / SecretKey 仅供 `npm run proxy` 使用
VITE_TENCENT_PROXY=http://127.0.0.1:9001
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 代理默认只绑定本机；仅在确有需要时显式改成 0.0.0.0，并务必同时设置 PROXY_AUTH_TOKEN
PROXY_BIND_HOST=127.0.0.1
# 非本机访问 ai3d-proxy 时必须携带的请求头：X-Proxy-Token
PROXY_AUTH_TOKEN=

# 仅限本地临时排障：允许浏览器直接持有腾讯云密钥。生产环境务必保持 false。
VITE_ALLOW_UNSAFE_TENCENT_BROWSER_CREDS=false

# 批量出图后端（可选）：设置后前端批量出图走后端，实现全公司 RPD 900 + 并发 2、Job 持久化
# 不设置则使用纯前端执行器（localStorage RPD、内存队列）
VITE_BULK_IMAGE_API=http://localhost:9002
# 后端环境变量（运行 node server/bulk-image-api.js 时使用）
# GEMINI_API_KEY=xxx
# BULK_IMAGE_PORT=9002
# BULK_IMAGE_RPD_DAILY_LIMIT=900
# BULK_IMAGE_MAX_CONCURRENT=2
# BULK_IMAGE_DATA_DIR=./.data/bulk-image
