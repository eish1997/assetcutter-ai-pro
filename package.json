{
  "name": "assetcutter-ai-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:script-hub-api": "node --env-file=.env.local server/script-hub-api.js",
    "dev:script-hub-stack": "concurrently -n auth,hubapi,hub -c magenta,cyan,blue \"npm run dev:auth-backend\" \"npm run dev:script-hub-api\" \"npm run script-hub:dev\"",
    "pg:dev:script-hub": "docker compose -f docker-compose.script-hub-dev.yml up -d",
    "pg:dev:script-hub:down": "docker compose -f docker-compose.script-hub-dev.yml down",
    "script-hub:dev": "npm run dev --prefix script-hub",
    "script-hub:build": "npm run build --prefix script-hub",
    "script-hub:typecheck": "npm run typecheck --prefix script-hub",
    "dev:auth-backend": "set PORT=9100&& node --env-file=.env.local server/auth-api.js",
    "start:auth-backend": "node server/auth-api.js",
    "dev:seam-backend": "node scripts/start-seam-backend.js",
    "dev:sam-local": "node scripts/start-sam-local.js",
    "setup:sam-local": "node scripts/setup-sam-local.mjs",
    "download:sam-vit-b": "node scripts/download-sam-vit-b-checkpoint.mjs",
    "dev:companion-sam-stack": "node scripts/dev-companion-sam-stack.mjs",
    "pack:sam-local-bundle": "node scripts/pack-sam-local-host-bundle.mjs",
    "smoke:host-bundle-catalog": "node scripts/smoke-host-bundle-catalog.mjs",
    "host-bridges:acceptance:check": "node scripts/check-host-bridge-acceptance.mjs",
    "host-bridges:acceptance:record": "node scripts/record-host-bridge-acceptance.mjs",
    "workflow:maya-real-smoke": "node scripts/workflow-maya-real-smoke.mjs",
    "smoke:agent-p1": "node scripts/agent-p1-smoke.mjs",
    "smoke:agent-p2-p3": "node scripts/agent-p2-p3-smoke.mjs",
    "agent:cli": "node scripts/agent-cli.mjs",
    "agent:init": "node scripts/agent-cli.mjs init",
    "companion:codex-one-click-check": "node scripts/check-codex-one-click-readiness.mjs",
    "companion:codex-auth-env": "node scripts/export-codex-shared-auth-env.mjs",
    "companion:codex-auth-env:check": "node scripts/validate-codex-shared-auth-env.mjs",
    "companion:codex-render-auth-env:apply": "node scripts/apply-codex-shared-auth-to-render.mjs",
    "companion:codex-production-check": "node scripts/verify-codex-one-click-production.mjs",
    "companion:codex-clean-machine-check": "node scripts/verify-codex-clean-machine.mjs",
    "companion:desktop-upload-manifest": "node scripts/prepare-companion-desktop-upload-manifest.mjs",
    "companion:desktop-publish": "node scripts/publish-companion-desktop-artifact.mjs",
    "companion:codex-finalize-production": "node scripts/finalize-codex-one-click-production.mjs",
    "validate:shell-tools": "npx --yes -p tsx tsx scripts/validate-shell-tools.ts",
    "pack:shell-tool": "npx --yes -p tsx tsx scripts/pack-shell-tool.mjs",
    "restart:local-stack": "powershell -NoProfile -ExecutionPolicy Bypass -File \"scripts/restart-local-stack.ps1\"",
    "restart:local-companion": "powershell -NoProfile -ExecutionPolicy Bypass -File \"scripts/restart-local-companion.ps1\"",
    "dev:all": "concurrently -n main,seam,auth -c blue,green,magenta \"npm run dev\" \"npm run dev:seam-backend\" \"npm run dev:auth-backend\"",
    "dev:with-r2": "concurrently -n vite,auth -c blue,magenta \"npm run dev\" \"node --env-file=.env.local server/auth-api.js\"",
    "guard:false-green": "node scripts/check-false-green-vite-env.mjs --mode=production",
    "build": "npm run -s guard:false-green && node scripts/write-build-meta.mjs && vite build",
    "typecheck": "tsc -p tsconfig.quality.json --noEmit",
    "lint": "eslint App.tsx types.ts components hooks services server scripts tests vite.config.ts",
    "test": "vitest run",
    "test:workflow-rings": "vitest run tests/workflowAuditAndOverlaySnapshots.test.ts",
    "lint:openapi": "spectral lint SamLocal/openapi.yaml",
    "preview": "vite preview",
    "proxy": "node --env-file=.env.local server/ai3d-proxy.js",
    "start:ai3d-proxy": "node server/ai3d-proxy.js",
    "dev:ai-worker-proxy": "node --env-file=.env.local server/ai-worker-proxy-api.js",
    "start:ai-worker-proxy": "node server/ai-worker-proxy-api.js",
    "dev:r2-api": "node --env-file=.env.local server/r2-storage-api.js",
    "start:r2-api": "node server/r2-storage-api.js",
    "seed:admin": "node scripts/seed-admin.js",
    "credits:reconcile": "node --env-file=.env.local scripts/credits-reconcile.js",
    "credits:grant-batch": "node --env-file=.env.local scripts/credits-grant-batch.js",
    "test:credits": "vitest run tests/credits.test.ts tests/creditsConsume.test.ts tests/creditsGate.test.ts tests/creditReserves.test.ts tests/proxyCreditsGate.test.ts --maxWorkers=1",
    "admin:online-config": "node scripts/admin-online-config.mjs",
    "admin:pull-online-config": "node scripts/admin-pull-online-config.mjs",
    "env:profile:check": "node scripts/env-profile-check.mjs",
    "env:profile:dev": "node scripts/env-profile-check.mjs --profile=dev",
    "env:profile:prod-like": "node scripts/env-profile-check.mjs --profile=prod-like",
    "smoke:ai-gateway-302": "node scripts/ai-gateway-302-staging-smoke.mjs",
    "smoke:ai-gateway-vertex": "node scripts/ai-gateway-vertex-handoff-smoke.mjs",
    "smoke:ai-gateway-jimeng": "node scripts/ai-gateway-jimeng-smoke.mjs",
    "smoke:ai-gateway-tripo": "node scripts/ai-gateway-tripo-smoke.mjs",
    "smoke:ai-gateway-matrix": "node scripts/ai-gateway-smoke-matrix.mjs",
    "smoke:build-sha": "node scripts/check-build-sha-alignment.mjs",
    "smoke:ai-gateway-r2": "node scripts/check-ai-gateway-r2-media.mjs",
    "migrate:auth-to-postgres": "node scripts/migrate-auth-json-to-postgres.js",
    "guard:persistence": "node scripts/check-persistence-guard.mjs",
    "guard:cloud-index": "node scripts/check-workspace-cloud-index-guard.mjs",
    "guard:workflow-inline-bytes": "node scripts/check-workflow-inline-bytes-guard.mjs",
    "guard:no-default-workflow-upload": "node scripts/check-no-default-workflow-upload.mjs",
    "guard:ai-routing": "node scripts/check-ai-routing-boundary.mjs && node scripts/check-no-client-provider-pin.mjs && npm run -s guard:provider-plug",
    "guard:provider-plug": "npx --yes -p tsx tsx scripts/check-provider-plug-contract.mjs",
    "guard:storage": "npm run -s guard:persistence && npm run -s guard:cloud-index && npm run -s guard:workflow-inline-bytes && npm run -s guard:no-default-workflow-upload",
    "local-companion:typecheck": "npm run typecheck --prefix local-companion",
    "local-companion:dev": "npm run dev --prefix local-companion",
    "local-companion:start": "npm run start --prefix local-companion",
    "companion-desktop:clean": "npm run clean --prefix companion-desktop",
    "companion-desktop:start": "npm run start --prefix companion-desktop",
    "companion-desktop:pack": "npm run pack --prefix companion-desktop",
    "companion-desktop:write-build-constants": "npm run write-build-constants --prefix companion-desktop",
    "companion-desktop:verify-update-pipeline": "powershell -NoProfile -ExecutionPolicy Bypass -File \"scripts/verify-companion-update-pipeline.ps1\"",
    "companion-desktop:dist:win": "npm run dist:win --prefix companion-desktop",
    "companion-desktop:dist:portable": "npm run dist:portable --prefix companion-desktop",
    "companion-desktop:dist:retry": "powershell -NoProfile -ExecutionPolicy Bypass -File \"scripts/companion-desktop-dist.ps1\" -Target both -Retries 3",
    "companion-desktop:release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File \"scripts/companion-desktop-release-check.ps1\"",
    "companion-desktop:check-asar-files": "node scripts/check-companion-desktop-asar-files.mjs",
    "companion-desktop:release:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File \"scripts/companion-release-pack.ps1\"",
    "dev-log:post-push": "node --env-file=.env.local scripts/dev-log-post-push.mjs",
    "dev-log:rewrite": "node --env-file=.env.local scripts/dev-log-post-push.mjs --rewrite"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.926.0",
    "@aws-sdk/s3-request-presigner": "^3.926.0",
    "@google/genai": "^1.34.0",
    "@types/three": "^0.182.0",
    "@xyflow/react": "^12.10.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.20.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tencentcloud-sdk-nodejs-common": "^4.1.122",
    "three": "^0.182.0",
    "undici": "^8.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stoplight/spectral-cli": "6.14.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "global-agent": "^4.1.3",
    "globals": "^17.4.0",
    "https-proxy-agent": "^9.0.0",
    "jsdom": "^29.1.0",
    "postcss": "^8.5.9",
    "shadcn": "^4.1.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
