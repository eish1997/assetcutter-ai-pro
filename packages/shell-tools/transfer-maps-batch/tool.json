    "entryModule": "transfermaps.main.maya_entry",
    "entryFunc": "show_transfer_window",
    "pythonPath": [
      "."
    ]
  },
  "permissions": [
    "host.open"
  ],
  "tags": [
    "Maya",
    "贴图",
    "传递"
  ],
  "minCompanionSemver": "0.1.0"
}
