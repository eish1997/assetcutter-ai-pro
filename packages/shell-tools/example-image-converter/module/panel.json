{
  "schemaVersion": 1,
  "title": "图片格式转换",
  "sections": [
    {
      "id": "input",
      "fields": [
        {
          "type": "path",
          "id": "sourceDir",
          "label": "图片文件夹",
          "pick": "directory",
          "required": true
        },
        {
          "type": "select",
          "id": "format",
          "label": "目标格式",
          "options": [
            { "value": "webp", "label": "WebP" },
            { "value": "png", "label": "PNG" },
            { "value": "jpg", "label": "JPEG" }
          ],
          "default": "webp"
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "convert",
      "label": "开始转换",
      "kind": "run",
      "style": "primary"
    }
  ],
  "outputs": [
    {
      "type": "log",
      "id": "runLog",
      "label": "运行日志"
    }
  ]
}
