{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetcutter.local/schemas/panel.schema.json",
  "title": "ShellToolPanelSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "sections", "actions", "outputs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fields"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "oneOf": [
        { "$ref": "#/$defs/fieldPath" },
        { "$ref": "#/$defs/fieldSelect" },
        { "$ref": "#/$defs/fieldText" },
        { "$ref": "#/$defs/fieldToggle" }
      ]
    },
    "fieldPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label", "pick"],
      "properties": {
        "type": { "const": "path" },
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pick": { "enum": ["directory", "file"] },
        "required": { "type": "boolean" }
      }
    },
    "fieldSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label", "options"],
      "properties": {
        "type": { "const": "select" },
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 64 },
              "label": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "default": { "type": "string", "maxLength": 64 },
        "required": { "type": "boolean" }
      }
    },
    "fieldText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label"],
      "properties": {
        "type": { "const": "text" },
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "default": { "type": "string", "maxLength": 512 },
        "required": { "type": "boolean" }
      }
    },
    "fieldToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label"],
      "properties": {
        "type": { "const": "toggle" },
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "default": { "type": "boolean" },
        "required": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["run", "openPath"] },
        "style": { "enum": ["primary", "default"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label"],
      "properties": {
        "type": { "const": "log" },
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
